# Private feasibility runtime only. Not a production image or a modified XPM.
FROM python:3.8-slim-bookworm@sha256:1d52838af602b4b5a831beb13a0e4d073280665ea7be7f69ce2382f29c5a613f
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LANG=C.UTF-8
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
    libtk8.6 default-jre-headless \
    && rm -rf /var/lib/apt/lists/*
COPY SciELO_XPM_4.0.096-R20231215.zip /opt/vendor.zip
RUN python -c "import hashlib,zipfile; p='/opt/vendor.zip'; assert hashlib.sha256(open(p,'rb').read()).hexdigest() == '1b22157b9e816255db8d8910acc46a13b78c0f286cbb68155a39a95ed0f0bdec'; zipfile.ZipFile(p).extractall('/opt/original')"
RUN python -m pip install --no-cache-dir --only-binary=:all: \
    pillow==6.2.2 packtools==2.4.2 lxml==6.1.3 picles.plumber==0.11 \
    && python -m pip freeze > /opt/dependencies.txt \
    && dpkg-query -W > /opt/system-packages.txt
COPY run_xpm_qualification.py /opt/run_xpm_qualification.py
USER 65534:65534
WORKDIR /work
ENTRYPOINT ["python", "/opt/run_xpm_qualification.py"]
