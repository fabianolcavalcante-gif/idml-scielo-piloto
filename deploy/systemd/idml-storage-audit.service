[Unit]
Description=Read-only IDML storage alerts and reconciliation
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/idml-platform/ops/audit-storage.sh
User=root
Group=root
Nice=10
TimeoutStartSec=45
StandardOutput=journal
StandardError=journal
# Nonzero status intentionally exposes warning/critical/incomplete to monitoring.
