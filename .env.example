IDML_ENVIRONMENT=development
IDML_DATABASE_URL=postgresql+psycopg://idml:change-me@postgres:5432/idml
IDML_REDIS_URL=redis://redis:6379/0
IDML_ARTIFACT_ROOT=/var/lib/idml/artifacts
# Optional trusted operator-managed catalog mount; keep unset until provisioned read-only.
# IDML_ENRICHMENT_ROOT=/var/lib/idml/enrichment
IDML_SESSION_PEPPER=generate-at-least-32-random-bytes
IDML_MFA_ENCRYPTION_KEY=generate-an-independent-32-byte-random-secret
IDML_BOOTSTRAP_EMAIL=admin@example.invalid
IDML_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
IDML_LOG_LEVEL=INFO
IDML_UPLOAD_MAX_BYTES=104857600
IDML_UPLOAD_MAX_CONCURRENCY=1
IDML_UPLOAD_TEMP_RESERVE_BYTES=268435456
IDML_UPLOAD_IDLE_TIMEOUT_SECONDS=30
IDML_UPLOAD_TOTAL_TIMEOUT_SECONDS=300
IDML_ARTIFACT_TENANT_QUOTA_BYTES=2147483648
IDML_ARTIFACT_TENANT_MAX_FILES=10000
IDML_ARTIFACT_DISK_RESERVE_BYTES=5368709120
IDML_ZIP_MAX_ENTRIES=5000
IDML_ZIP_MAX_UNCOMPRESSED_BYTES=524288000
IDML_ZIP_MAX_RATIO=100
IDML_ZIP_MAX_DEPTH=16
IDML_ZIP_MAX_PATH_BYTES=512
IDML_SESSION_TTL_SECONDS=28800
IDML_FEATURE_OPENCLAW=false
IDML_FEATURE_AI_SWARM=false
# Generate an independent 32-byte random token before starting the dedicated gateway.
IDML_OPENCLAW_GATEWAY_URL=http://openclaw-idml:47716
IDML_OPENCLAW_GATEWAY_TOKEN=
# Stored on the VPS only; injected into OpenClaw solely by the explicit provider overlay.
IDML_OPENAI_API_KEY=
IDML_AI_TIMEOUT_SECONDS=45
IDML_AI_MAX_ATTEMPTS=2
IDML_AI_MAX_INPUT_TOKENS=12000
IDML_AI_MAX_OUTPUT_TOKENS=2000
IDML_AI_MAX_COST_MICROUSD=50000
IDML_AI_MAX_CONCURRENCY=1
IDML_AI_CONFIDENCE_THRESHOLD=0.85
IDML_AI_MAX_REPAIR_CYCLES=2
IDML_FEATURE_CLAMAV=false
# Optional Linux broker; leave unset until isolated-validator qualification/deployment.
# IDML_VALIDATOR_SOCKET=/run/idml-validator/broker.sock
# Opt-in only after scoped authority provisioning and candidate image qualification.
IDML_VALIDATOR_SCOPED_AUTHORITIES=false
# IDML_VALIDATOR_REGISTRY_PATH=/app/config/validator-registry-vh1-scoped.json
# IDML_JOURNAL_PROFILE_PATH=/app/profiles/esa-aop-1.1.json
IDML_CLAMAV_HOST=clamav
IDML_CLAMAV_PORT=3310
