{
  "meta": {
    "lastTouchedVersion": "2026.6.11"
  },
  "env": {
    "shellEnv": {
      "enabled": false
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "auth": "api-key",
        "api": "openai-responses",
        "agentRuntime": {
          "id": "openclaw"
        },
        "timeoutSeconds": 45,
        "request": {
          "allowPrivateNetwork": false
        },
        "models": [
          {
            "id": "gpt-5.4-mini",
            "name": "GPT-5.4 Mini",
            "reasoning": true,
            "input": [
              "text",
              "image"
            ],
            "cost": {
              "input": 0.75,
              "output": 4.5,
              "cacheRead": 0.075,
              "cacheWrite": 0
            },
            "contextWindow": 400000,
            "contextTokens": 32000,
            "maxTokens": 4000
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 47716,
    "auth": {
      "mode": "token",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": false
      }
    },
    "controlUi": {
      "enabled": false,
      "allowInsecureAuth": false,
      "dangerouslyDisableDeviceAuth": false,
      "dangerouslyAllowHostHeaderOriginFallback": false
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": false
        },
        "responses": {
          "enabled": true,
          "maxBodyBytes": 1048576,
          "maxUrlParts": 0,
          "files": {
            "allowUrl": false,
            "maxBytes": 1048576,
            "maxRedirects": 0,
            "timeoutMs": 1000,
            "maxChars": 100000
          },
          "images": {
            "allowUrl": false,
            "maxBytes": 1048576,
            "maxRedirects": 0,
            "timeoutMs": 1000
          }
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "maxConcurrent": 1,
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5.4-mini",
        "fallbacks": []
      },
      "heartbeat": {
        "every": "0m"
      },
      "subagents": {
        "allowAgents": [],
        "requireAgentId": true
      }
    },
    "list": [
      {
        "id": "idml-evaluator",
        "name": "IDML Evaluator",
        "default": true,
        "workspace": "/home/node/.openclaw/workspace",
        "model": {
          "primary": "openai/gpt-5.4-mini",
          "fallbacks": []
        },
        "thinkingDefault": "medium",
        "heartbeat": {
          "every": "0m"
        },
        "skills": [],
        "tools": {
          "profile": "minimal",
          "allow": [],
          "alsoAllow": [],
          "deny": [
            "*"
          ],
          "elevated": {
            "enabled": false,
            "allowFrom": {}
          },
          "exec": {
            "mode": "deny"
          },
          "fs": {
            "workspaceOnly": true
          }
        }
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "allow": [],
    "alsoAllow": [],
    "deny": [
      "*"
    ],
    "agentToAgent": {
      "enabled": false,
      "allow": []
    },
    "elevated": {
      "enabled": false,
      "allowFrom": {}
    },
    "exec": {
      "mode": "deny"
    },
    "fs": {
      "workspaceOnly": true
    }
  },
  "skills": {
    "allowBundled": [],
    "load": {
      "extraDirs": [],
      "allowSymlinkTargets": [],
      "watch": false
    }
  },
  "plugins": {
    "enabled": false,
    "allow": [],
    "deny": [],
    "load": {
      "paths": []
    }
  }
}
