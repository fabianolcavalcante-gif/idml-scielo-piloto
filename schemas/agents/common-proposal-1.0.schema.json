{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idml.local/schemas/agents/common-proposal-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "patch", "confidence", "evidence", "alternatives", "reason", "needs_human"],
  "properties": {
    "schema_version": {"const": "agent-proposal-1.0"},
    "domain": {"type": "string", "enum": ["metadata", "contributors_affiliations", "structure", "references", "figures_tables", "math_notes"]},
    "patch": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["op", "path", "value"], "properties": {"op": {"const": "replace"}, "path": {"type": "string", "pattern": "^/", "maxLength": 500}, "value": {}}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source_kind", "locator", "excerpt_sha256"], "properties": {"evidence_id": {"type": "string", "minLength": 1, "maxLength": 200}, "source_kind": {"enum": ["idml", "pdf", "validation", "canonical"]}, "locator": {"type": "string", "minLength": 1, "maxLength": 500}, "excerpt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "alternatives": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 20, "maxLength": 2000},
    "needs_human": {"type": "boolean"}
  }
}
